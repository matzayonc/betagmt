# Copy to your shell (export ...) or prefix the npm command.
RPC_URL=https://api.mainnet-beta.solana.com   # use a private RPC (Helius/Triton/QuickNode) for reliability
KEYPAIR=~/.config/solana/id.json
MARKET=SOL/USD[WSOL-USDC]
COLLATERAL_USDC=5
SIZE_USD=10
IS_LONG=true
PRIORITY_FEE_MICRO_LAMPORTS=50000
# LEGS overrides MARKET/IS_LONG; each leg uses SIZE_USD and COLLATERAL_USDC
# LEGS=SPY/USD[USDC-USDC]:long,EUR/USD[USDC-USDC]:long
